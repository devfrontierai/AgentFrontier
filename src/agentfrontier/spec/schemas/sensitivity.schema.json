{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devfrontierai/agentfrontier-spec/schemas/sensitivity.schema.json",
  "title": "AgentFrontier sensitivity labels",
  "description": "An ordered set of sensitivity labels and the classifications that map to them; see docs/sensitivity.md.",
  "type": "object",
  "required": ["version", "default", "labels", "classifications"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "default": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "rank"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 0},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "classifications": {
      "type": "object",
      "description": "Classification label (exact, or a glob with *) -> sensitivity label id.",
      "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    }
  },
  "additionalProperties": false
}
