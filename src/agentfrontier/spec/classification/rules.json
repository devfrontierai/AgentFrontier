{
  "version": "1.0.0",
  "engine": "agentfrontier-rules",
  "description": "Built-in rule-based classifiers for personal, payment, financial, health and secret data. Detectors read field names, field comments and sample values; see docs/classification.md. Patterns use the regular-expression syntax Python and Java share.",
  "rules": [
    {
      "id": "pii.email",
      "label": "pii.email",
      "labelType": "classification",
      "value": "confidential",
      "name": {"patterns": ["(?i)^.*e[-_]?mail([-_]?addr(ess)?)?$"], "confidence": 0.7},
      "comment": {"patterns": ["(?i)\\be-?mail\\b"], "confidence": 0.6},
      "values": {"patterns": ["^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"], "confidence": 0.9}
    },
    {
      "id": "pii.phone",
      "label": "pii.phone",
      "labelType": "classification",
      "value": "confidential",
      "name": {"patterns": ["(?i)^(.*(phone|mobile|fax)|(.*[-_])?(tel|cell))([-_]?(no|num|number))?$"], "confidence": 0.7},
      "comment": {"patterns": ["(?i)\\b(phone|mobile|telephone)\\b"], "confidence": 0.5},
      "values": {"patterns": ["^(\\+[0-9]{1,3}[ .-]?)?(\\([0-9]{2,4}\\)[ .-]?|[0-9]{2,4}[ .-])[0-9]{3,4}[ .-]?[0-9]{3,4}$"], "confidence": 0.8}
    },
    {
      "id": "pii.person_name",
      "label": "pii.person_name",
      "labelType": "classification",
      "value": "confidential",
      "name": {"patterns": ["(?i)^(.*[-_])?(first|last|middle|given|family|full|sur|maiden)[-_]?name$", "(?i)^name[-_]?(first|last)$"], "confidence": 0.7}
    },
    {
      "id": "pii.date_of_birth",
      "label": "pii.date_of_birth",
      "labelType": "classification",
      "value": "confidential",
      "name": {"patterns": ["(?i)(date[-_]?of[-_]?birth|birth[-_]?date|^dob$|birthday)"], "confidence": 0.8},
      "comment": {"patterns": ["(?i)\\b(date of birth|birth ?date)\\b"], "confidence": 0.6}
    },
    {
      "id": "pii.national_id",
      "label": "pii.national_id",
      "labelType": "classification",
      "value": "restricted",
      "name": {"patterns": ["(?i)(^|[-_])(ssn|social[-_]?security([-_]?(no|num|number))?|national[-_]?id|tax[-_]?id|tin)($|[-_])"], "confidence": 0.8},
      "comment": {"patterns": ["(?i)\\b(social security|national id)\\b"], "confidence": 0.6},
      "values": {"patterns": ["^[0-9]{3}-[0-9]{2}-[0-9]{4}$"], "confidence": 0.85}
    },
    {
      "id": "pii.address",
      "label": "pii.address",
      "labelType": "classification",
      "value": "confidential",
      "name": {"patterns": ["(?i)^((home|billing|shipping|mailing|postal|delivery|residential|customer|contact|primary|work)[-_]?)?(street([-_]?address)?|address([-_]?line)?([-_]?[0-9])?|addr([-_]?[0-9])?|postal[-_]?code|zip([-_]?code)?|post[-_]?code)$"], "confidence": 0.6}
    },
    {
      "id": "pii.ip_address",
      "label": "pii.ip_address",
      "labelType": "classification",
      "value": "internal",
      "name": {"patterns": ["(?i)(^|[-_])ip([-_]?addr(ess)?)?($|[-_])"], "confidence": 0.6},
      "values": {"patterns": ["^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"], "confidence": 0.9}
    },
    {
      "id": "pii.passport",
      "label": "pii.passport",
      "labelType": "classification",
      "value": "restricted",
      "name": {"patterns": ["(?i)passport"], "confidence": 0.8}
    },
    {
      "id": "pii.driver_license",
      "label": "pii.driver_license",
      "labelType": "classification",
      "value": "restricted",
      "name": {"patterns": ["(?i)driv(er|ing)s?[-_]?licen[cs]e"], "confidence": 0.8}
    },
    {
      "id": "pci.card_number",
      "label": "pci.card_number",
      "labelType": "classification",
      "value": "restricted",
      "name": {"patterns": ["(?i)(card[-_]?(no|num|number)|credit[-_]?card|^pan$|(^|[-_])cc[-_]?(no|num|number)$)"], "confidence": 0.8},
      "values": {"patterns": ["^[0-9]{13,19}$", "^[0-9]{4}([ -][0-9]{4}){3}$"], "validator": "luhn", "confidence": 0.95}
    },
    {
      "id": "pci.cvv",
      "label": "pci.cvv",
      "labelType": "classification",
      "value": "restricted",
      "name": {"patterns": ["(?i)^(.*[-_])?(cvv2?|cvc2?|card[-_]?verification([-_]?(code|value))?)$"], "confidence": 0.9}
    },
    {
      "id": "finance.iban",
      "label": "finance.iban",
      "labelType": "classification",
      "value": "restricted",
      "name": {"patterns": ["(?i)iban"], "confidence": 0.8},
      "values": {"patterns": ["^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$"], "validator": "iban", "confidence": 0.95}
    },
    {
      "id": "finance.bank_account",
      "label": "finance.bank_account",
      "labelType": "classification",
      "value": "restricted",
      "name": {"patterns": ["(?i)(bank[-_]?account|(^|[-_])account[-_]?(no|num|number)$|routing[-_]?(no|num|number)|sort[-_]?code)"], "confidence": 0.7}
    },
    {
      "id": "phi.medical",
      "label": "phi.medical",
      "labelType": "classification",
      "value": "restricted",
      "name": {"patterns": ["(?i)(medical[-_]?record|^mrn$|diagnos(is|es)|icd[-_]?(9|10)|prescription|patient[-_]?id)"], "confidence": 0.7},
      "comment": {"patterns": ["(?i)\\b(medical|diagnosis|patient|health)\\b"], "confidence": 0.5}
    },
    {
      "id": "secret.password",
      "label": "secret.password",
      "labelType": "classification",
      "value": "secret",
      "name": {"patterns": ["(?i)(passw(or)?d|^pwd$|passphrase)"], "confidence": 0.9},
      "comment": {"patterns": ["(?i)\\bpassword\\b"], "confidence": 0.7}
    },
    {
      "id": "secret.credential",
      "label": "secret.credential",
      "labelType": "classification",
      "value": "secret",
      "name": {"patterns": ["(?i)(api[-_]?key|secret|access[-_]?token|auth[-_]?token|refresh[-_]?token|private[-_]?key|client[-_]?secret|credential)"], "confidence": 0.8},
      "comment": {"patterns": ["(?i)\\b(api key|secret|access token|credential)s?\\b"], "confidence": 0.6},
      "values": {
        "patterns": [
          "^AKIA[0-9A-Z]{16}$",
          "^gh[pousr]_[A-Za-z0-9]{36,}$",
          "^xox[abprs]-[A-Za-z0-9-]{10,}$",
          "^sk-[A-Za-z0-9_-]{20,}$",
          "^eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "^-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*$"
        ],
        "minFraction": 0.5,
        "confidence": 0.95
      }
    }
  ]
}
