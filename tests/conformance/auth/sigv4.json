{
  "description": "SigV4 test vectors (docs/auth.md). The first five are AWS's own published examples; the others were computed by the Python edition, whose signer reproduces those five, and cover what the object storage and STS code paths send. Each implementation signs `request` with `credentials` at `amzDate` and must add exactly `expectedHeaders`.",
  "vectors": [
    {
      "description": "AWS test suite get-vanilla",
      "request": {
        "method": "GET",
        "url": "https://example.amazonaws.com/",
        "headers": {},
        "body": ""
      },
      "credentials": {
        "accessKeyId": "AKIDEXAMPLE",
        "secretAccessKey": "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
      },
      "region": "us-east-1",
      "service": "service",
      "amzDate": "20150830T123600Z",
      "expectedHeaders": {
        "X-Amz-Date": "20150830T123600Z",
        "Authorization": "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/service/aws4_request, SignedHeaders=host;x-amz-date, Signature=5fa00fa31553b73ebf1942676e86291e8372ff2a2260956d9b8aae1d763fbf31"
      }
    },
    {
      "description": "AWS test suite get-vanilla-query-order-key-case",
      "request": {
        "method": "GET",
        "url": "https://example.amazonaws.com/?Param2=value2&Param1=value1",
        "headers": {},
        "body": ""
      },
      "credentials": {
        "accessKeyId": "AKIDEXAMPLE",
        "secretAccessKey": "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
      },
      "region": "us-east-1",
      "service": "service",
      "amzDate": "20150830T123600Z",
      "expectedHeaders": {
        "X-Amz-Date": "20150830T123600Z",
        "Authorization": "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/service/aws4_request, SignedHeaders=host;x-amz-date, Signature=b97d918cfa904a5beff61c982a1b6f458b799221646efd99d3219ec94cdf2500"
      }
    },
